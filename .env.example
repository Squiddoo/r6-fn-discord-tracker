# Copy this file to `.env` for local runs.
# On GitHub, add the same names under Settings → Secrets and variables → Actions.
# Never commit a filled `.env`.

# Required
DISCORD_WEBHOOK_URL=
FORTNITE_API_KEY=

# Rainbow Six — set ARENYZE_API_KEY, or both Ubisoft fields (throwaway account)
UBISOFT_EMAIL=
UBISOFT_PASSWORD=
ARENYZE_API_KEY=

# Siege players (platform: pc | psn | xbox)
R6_PLAYER_1_NAME=
R6_PLAYER_1_PLATFORM=pc
R6_PLAYER_2_NAME=
R6_PLAYER_2_PLATFORM=pc
R6_PLAYER_3_NAME=
R6_PLAYER_3_PLATFORM=pc
R6_PLAYER_4_NAME=
R6_PLAYER_4_PLATFORM=psn

# Fortnite players (account type: epic | psn | xbl)
FN_PLAYER_1_NAME=
FN_PLAYER_1_ACCOUNT_TYPE=epic
FN_PLAYER_2_NAME=
FN_PLAYER_2_ACCOUNT_TYPE=epic
FN_PLAYER_3_NAME=
FN_PLAYER_3_NAME_FALLBACK=
FN_PLAYER_3_ACCOUNT_TYPE=epic
FN_PLAYER_4_NAME=
FN_PLAYER_4_ACCOUNT_TYPE=psn
